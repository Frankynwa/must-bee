# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real credentials.

# Required for anything that talks to Moodle
MUSTER_USERNAME=your-student-id
MUSTER_PASSWORD=your-password

# Optional
# MUSTER_DOWNLOAD_PATH=~/.must-bee
# MUSTER_NO_SANDBOX=0
# MUSTER_MAX_DOWNLOAD_MB=200
# MUSTER_PYTHON=python3

# Optional: Obsidian review notes (`notes`)
# DEEPSEEK_API_KEY=sk-your-key
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# OBSIDIAN_VAULT_PATH=~/Obsidian
